# Copy to .env.local for local testing. On Vercel, add these per project (test / live) as "Sensitive".
# Full guide: SETUP.md · Security notes: SECURITY.md · Never commit real values.

# Which site this is: "test" or "production"
APP_ENV=test

# ── Stripe ─────────────────────────────────────────────────────────
# One Stripe account per house (each paid into its own bank account):
STRIPE_SECRET_KEY_KAJA=     # Villa Kaja account: rk_test_… on the test site, rk_live_… on the live site
STRIPE_SECRET_KEY_JANIS=    # Jani's account:     rk_test_… on the test site, rk_live_… on the live site
STRIPE_WEBHOOK_SECRET_KAJA= # whsec_… of the webhook in the Villa Kaja account
STRIPE_WEBHOOK_SECRET_JANIS=# whsec_… of the webhook in the Jani's account
# Or ONE account for both houses: set only these two instead
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
CRON_SECRET=                # long random value: openssl rand -hex 32

# ── Database (Neon Postgres) ───────────────────────────────────────
# Set automatically by Vercel → Storage → Neon (one database per site). Locally, e.g.
# DATABASE_URL=postgresql://postgres@localhost:5432/seaski
DATABASE_URL=

# ── Email (pick ONE) ───────────────────────────────────────────────
# A) a mailbox with an app password (Gmail: smtp.gmail.com · Yahoo: smtp.mail.yahoo.com)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# B) Resend with your own domain
RESEND_API_KEY=
EMAIL_FROM=                 # e.g. Sea & Ski Villas <bookings@seaandskivillas.com>

# ── Admin page (/admin) ────────────────────────────────────────────
HOST_TOTP_SECRET=           # npm run host:2fa (strongly recommended)
# Optional overrides (defaults in lib/site-config.ts):
# ADMIN_EMAILS=regalo1996@yahoo.com,stanislava.ilievska@gmail.com
# NOTIFY_EMAILS=regalo1996@yahoo.com
# HOST_PASSWORD=            # optional fallback login, 12+ characters

# ── Calendars ──────────────────────────────────────────────────────
BOOKING_ICAL_KAJA=
BOOKING_ICAL_JANIS=

# ── PDF confirmation footer (once you have them) ──────────────────
BUSINESS_LEGAL_NAME=
BUSINESS_ADDRESS=
BUSINESS_TAX_ID=

NEXT_PUBLIC_SITE_URL=
